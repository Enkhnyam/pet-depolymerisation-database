# --- environment -----------------------------------------------------------------------------
.venv/
.env
__pycache__/

# --- everything this repository does not publish ----------------------------------------------
# core/paths.py states the policy: pushable source lives at the project root, and everything we
# cannot push -- copyrighted paper text, model run output, generated reports and figures -- lives
# under artifacts/. There is no exception. An earlier version kept artifacts/backup/ so the
# manuscript could be rebuilt from a clone, and that folder carried the converted full text of 24
# papers, only 7 of which are licensed for redistribution. Rebuilding from a clone is not worth
# republishing other people's articles.
/artifacts/

# Local corpora, run logs and experiment tracking: inputs we were licensed to read, not to pass on.
/download_data_pdf/
/download_data_xml/
/logs/
/wandb/

# --- manuscript ------------------------------------------------------------------------------
# The paper itself is published by the journal; this repository is the code behind it.
*.tex
*.pdf
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
/overleaf/

# --- working notes, not documentation ---------------------------------------------------------
# Kept locally because they are useful; not published because they are a running conversation with
# ourselves rather than anything a reader of this repository needs.
/PLAN.md
/VERIFY.md
/VERIFY-audit.md

# --- editor and office junk -------------------------------------------------------------------
.~lock.*#
.claude/
*.code-workspace
.DS_Store
